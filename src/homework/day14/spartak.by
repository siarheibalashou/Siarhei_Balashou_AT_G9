Logo: //a[contains(@class,'header_logo_img')]/img[contains(@alt,'логотип')]
Инфо для партнеров - //span[text()='Информация для партнеров']/..
Лупа - //i[contains(@class,'search') or contains(@class,'lupa')]
Глаз - //span[@class='header__eye']//img
Ru - //div[@class='header__lang']//a[text()='Ru']
CN- //div[@class='header__lang']//a[@href='/cn/']
Скачать каталог - //a[@class='download-catalog']
Импрессо - //div[@class='child_wrapp']//a[@href='/products/Impresso/']
навигация - //ol[@class='flex-control-nav flex-control-paging']/li[1]
vk - //div[@class='top_slider_wrapp']//ul[@class='social_list']//img[contains(@src,'VK.svg')]
youtube - //div[@class='top_slider_wrapp']//ul[@class='social_list']//img[contains(@src,'youtube.svg')]
